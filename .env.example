# Local development settings. Copy to .env (gitignored) and fill in the placeholders:
#   cp .env.example .env
# deploy/local/env.sh loads .env for every `just dev*` recipe and gives the defaults shown
# here to anything left unset. .worktreeinclude copies .env into new worktrees.
# Never commit .env: it holds your LAN address and local passwords.

# ---- LLM: KAT-Coder on a LAN GPU box (llama-server, OpenAI-compatible chat + tools) ----
# Not run on the Mac. The box has one slot, so requests run one at a time.
VAK_LLM_BASE_URL=http://<gpu-box-host>:<port>/v1
VAK_LLM_MODEL=KAT-Coder-V2.5-Dev
# Bearer token, if the server wants one. Empty for the LAN box; prod uses Databricks OAuth.
VAK_LLM_API_KEY=
# JSON merged into every chat request. Voice turns must run with thinking off.
VAK_LLM_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'

# ---- Models on disk (`just models-pull`), shared by every worktree ----
VAK_MODELS_DIR=$HOME/.cache/vak/models

# ---- Speech: mlx-audio :8000 behind vak-model-shim :8001 (Databricks invocation shapes) ----
VAK_STT_BASE_URL=http://127.0.0.1:8001
VAK_STT_ENDPOINT=stt
VAK_TTS_BASE_URL=http://127.0.0.1:8001
VAK_TTS_ENDPOINT=tts
# Shim settings (backend/apps/model-shim/CLAUDE.md); the defaults follow VAK_MODELS_DIR.
# VAK_SHIM_ADDR=127.0.0.1:8001
# VAK_SHIM_MLX_AUDIO_URL=http://127.0.0.1:8000
# VAK_SHIM_STT_MODEL=$VAK_MODELS_DIR/mlx-community/parakeet-tdt-0.6b-v2
# VAK_SHIM_TTS_MODEL=$VAK_MODELS_DIR/mlx-community/Kokoro-82M-bf16
# VAK_SHIM_TIMEOUT_MS=30000

# ---- Decisions: llama-server /v1/systemone with Kev-4B ----
VAK_DECISION_BASE_URL=http://127.0.0.1:8081
VAK_DECISION_MODEL=Kev-4B
# The GGUF file llama-server loads (`just dev` only); the default follows VAK_MODELS_DIR.
# VAK_DECISION_GGUF=$VAK_MODELS_DIR/ggml-org/Kev-4B-GGUF/Kev-4B-Q4_K_M.gguf
# The API path under the base URL. Unset means /v1/systemone (llama-server); Databricks
# serves /ai-gateway/typesafe/v1/systemone.
# VAK_DECISION_PATH=/v1/systemone

# ---- Postgres 18 in Docker (`just db-up`) ----
# Host port 5433: a Homebrew Postgres often holds 5432.
VAK_PG_PORT=5433
# Any local-only value; the container is created with it on first start.
VAK_PG_PASSWORD=<choose-a-local-password>
DATABASE_URL=postgres://vak:${VAK_PG_PASSWORD}@127.0.0.1:${VAK_PG_PORT}/vak

# ---- vak-server ----
# `local` (the default) or `databricks`. Locally it stays local: the dev operator below is
# refused in any other profile.
# VAK_PROFILE=local
VAK_HTTP_ADDR=127.0.0.1:3000
# How long an API request may take before it is answered with a 503, in milliseconds
# (1 to 300000). The media WebSocket doesn't run under it.
# VAK_HTTP_REQUEST_TIMEOUT_MS=10000
VAK_LOG=info
# API requests without identity headers act as this operator (local profile only; Databricks
# Apps sends X-Forwarded-User/Email in production). Leave it empty to require the headers.
VAK_DEV_OPERATOR_EMAIL=dev@localhost
