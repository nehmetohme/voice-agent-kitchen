{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client", "@testing-library/jest-dom/vitest"]
  },
  "include": [
    "*.config.ts",
    ".storybook",
    "e2e",
    "tokens",
    "tools",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test"
  ]
}
