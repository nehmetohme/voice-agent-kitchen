{
  "name": "@vak/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "e2e": "playwright test",
    "tokens": "node tokens/build.ts",
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:build": "storybook build --quiet",
    "api:generate": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.3.0",
    "@storybook/react-vite": "10.6.5",
    "@swc/core": "1.16.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "orval": "8.45.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "size-limit": "14.3.0",
    "storybook": "10.6.5",
    "style-dictionary": "5.7.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1"
}
